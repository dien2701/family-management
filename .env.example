# =================================================================
# File mẫu cấu hình triển khai Docker Compose (.env)
# Trên máy chủ, chạy: cp .env.example .env rồi điền các giá trị thật
# =================================================================

# Cổng truy cập ứng dụng trên server (mặc định 80 để trỏ domain trực tiếp)
PORT=80

# --- Cơ sở dữ liệu MySQL 8.4 ---
DB_NAME=giapha
DB_USERNAME=giapha
DB_PASSWORD=giapha_secure_password_replace_me
DB_ROOT_PASSWORD=root_secure_password_replace_me

# --- JWT: chuỗi ngẫu nhiên >= 32 byte (ví dụ lệnh: openssl rand -base64 48) ---
JWT_SECRET=giapha_jwt_secret_key_minimum_32_bytes_long_1234567890

# --- Tài khoản Admin gốc (khi đăng ký/đăng nhập email này sẽ tự động thành Admin) ---
ROOT_ADMIN_EMAIL=admin@example.com

# --- Đăng nhập Google (Google Identity Services) - Tùy chọn ---
GOOGLE_CLIENT_ID=

# --- Cloudinary (Lưu trữ ảnh đại diện, file đính kèm) - Tùy chọn ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMTP Gửi email OTP (Gmail App Password, Brevo, ...) - Tùy chọn ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@giapha.vn

# --- Web Push VAPID (Thông báo đẩy trên trình duyệt/PWA) - Tùy chọn ---
# Sinh bằng: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Trợ lý AI (Google Gemini) - Tùy chọn ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
