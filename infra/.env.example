# Trên VPS: cp .env.example /opt/giapha/.env rồi điền giá trị thật. KHÔNG commit file .env.
# Biến ghi "bắt buộc" mà để trống thì `docker compose` từ chối chạy.

# --- Image (GHCR) ---
GHCR_OWNER=dien2701          # bắt buộc, chữ thường: tài khoản/tổ chức GitHub sở hữu repo
IMAGE_TAG=latest             # đổi sang mã commit để quay về bản cũ

# --- MySQL ---
DB_NAME=giapha
DB_USERNAME=giapha
DB_PASSWORD=                 # bắt buộc: openssl rand -base64 24
DB_ROOT_PASSWORD=            # bắt buộc: openssl rand -base64 24

# --- Bảo mật ---
JWT_SECRET=                  # bắt buộc, >= 32 byte: openssl rand -base64 48
ROOT_ADMIN_EMAIL=            # bắt buộc: email đăng ký đầu tiên sẽ thành Admin

# --- SMTP gửi OTP (bắt buộc ở prod) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- Cloudinary (bắt buộc) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gemini (bắt buộc) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Tùy chọn ---
# Chưa có thì để trống: nút Google ẩn. Có thì đặt cả biến GitHub VITE_GOOGLE_CLIENT_ID (xem README) rồi deploy lại.
GOOGLE_CLIENT_ID=
# Web Push: chưa có thì để trống (không gửi được thông báo đẩy). Sinh: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@giapha.click
