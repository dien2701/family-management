# Copy thành .env.local. Chỉ đặt giá trị công khai; bí mật không bao giờ để ở frontend.
# Client ID kiểu Web của Google Cloud (cùng giá trị GOOGLE_CLIENT_ID của backend). Để trống thì ẩn nút Google.
VITE_GOOGLE_CLIENT_ID=

# Đặt `mock` để chạy frontend bằng lớp giả lập (dữ liệu trong localStorage). Chỉ có tác dụng ở dev server, `npm run dev:mock` tự đặt.
VITE_API_MODE=
