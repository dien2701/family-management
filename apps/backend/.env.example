# Copy file này thành .env (không commit) rồi điền giá trị thật.

# --- Database (khớp infra/docker-compose.dev.yml) ---
DB_HOST=localhost
DB_PORT=3307
DB_NAME=giapha
DB_USERNAME=giapha
DB_PASSWORD=giapha_dev

# --- JWT (HS256): chuỗi ngẫu nhiên >= 32 byte, ví dụ `openssl rand -base64 48` ---
JWT_SECRET=

# --- Admin gốc (Đợt 8): email này đăng ký/đăng nhập khi hệ thống chưa có Admin nào thì tự thành Admin đã duyệt ---
ROOT_ADMIN_EMAIL=

# --- Google Identity Services (Đợt 2) ---
GOOGLE_CLIENT_ID=

# --- Cloudinary (Đợt 30) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gửi email OTP (prod; dev dùng ConsoleMailSender) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- Web Push VAPID (Đợt 28) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Gemini (Đợt 35) ---
GEMINI_API_KEY=
